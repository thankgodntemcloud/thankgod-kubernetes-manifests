# Settings for the AI assistant pods (namespace ai-assistant). Loaded as ConfigMap "ai-env".

# ---- AI services (same namespace) ----
CHATBOT_PORT=7860
CHATBOT_ROOT_PATH=/chatbot
AGENT_ENDPOINT=agent
AGENT_PORT=8010
MCP_ENDPOINT=mcp
MCP_PORT=8011

# ---- The shop API the AI tools call (namespace ecommerce-app) ----
APPLICATION_ENDPOINT=frontend.ecommerce-app:8080

# ---- Telemetry (collector in "observability") ----
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector.observability:4317
OTEL_EXPORTER_OTLP_METRICS_TEMPORALITY_PREFERENCE=cumulative
OTEL_SERVICE_NAMESPACE=opentelemetry-demo
TRACELOOP_BASE_URL=http://otel-collector.observability:4318
