# Shared settings for every pod in ecommerce-app (from ecommerce-final-project's .env),
# rewritten for the 4-namespace layout. Loaded as ConfigMap "app-env".

# ---- Telemetry (collector lives in "observability") ----
OTEL_COLLECTOR_HOST=otel-collector.observability
OTEL_COLLECTOR_PORT_GRPC=4317
OTEL_COLLECTOR_PORT_HTTP=4318
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector.observability:4317
OTEL_EXPORTER_OTLP_METRICS_TEMPORALITY_PREFERENCE=cumulative
OTEL_SERVICE_NAMESPACE=opentelemetry-demo
PUBLIC_OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=https://shop.digitalwitch.online/otlp-http/v1/traces
OPAMP_SERVER_HOST=opamp-server.observability
OPAMP_SERVER_UI_PORT=4321
GRAFANA_HOST=grafana.observability
GRAFANA_PORT=3000
JAEGER_HOST=jaeger.observability
JAEGER_UI_PORT=16686
ENV_PLATFORM=eks
IPV6_ENABLED=false

# ---- Data stores (live in "ecommerce-data") ----
VALKEY_ADDR=valkey-cart.ecommerce-data:6379
POSTGRES_HOST=astronomy-db.ecommerce-data
POSTGRES_PORT=5432
KAFKA_ADDR=kafka.ecommerce-data:9092
KAFKA_TOPIC=orders

# ---- Shop services (same namespace: short names) ----
AD_PORT=9555
AD_ADDR=ad:9555
AD_PROMETHEUS_PORT=9465
CART_PORT=7070
CART_ADDR=cart:7070
CHECKOUT_PORT=5050
CHECKOUT_ADDR=checkout:5050
CURRENCY_PORT=7001
CURRENCY_ADDR=currency:7001
EMAIL_PORT=6060
EMAIL_ADDR=http://email:6060
PAYMENT_PORT=50051
PAYMENT_ADDR=payment:50051
PRODUCT_CATALOG_PORT=3550
PRODUCT_CATALOG_ADDR=product-catalog:3550
QUOTE_PORT=8090
QUOTE_ADDR=http://quote:8090
RECOMMENDATION_PORT=9001
RECOMMENDATION_ADDR=recommendation:9001
SHIPPING_PORT=50050
SHIPPING_ADDR=http://shipping:50050
FRONTEND_HOST=frontend
FRONTEND_PORT=8080
FRONTEND_ADDR=frontend:8080
FRONTEND_PROXY_ADDR=frontend-proxy:8080
ENVOY_ADDR=0.0.0.0
ENVOY_PORT=8080
ENVOY_ADMIN_PORT=10000
IMAGE_PROVIDER_HOST=image-provider
IMAGE_PROVIDER_PORT=8081
TELEMETRY_DOCS_HOST=telemetry-docs
TELEMETRY_DOCS_PORT=8000
FLAGD_HOST=flagd
FLAGD_PORT=8013
FLAGD_OFREP_PORT=8016
FLAGD_UI_HOST=flagd-ui
FLAGD_UI_PORT=4000

# ---- Load generator (Locust) ----
LOCUST_WEB_HOST=load-generator
LOCUST_WEB_PORT=8089
LOCUST_USERS=5
LOCUST_HOST=http://frontend-proxy:8080
LOCUST_AUTOSTART=true
LOCUST_HEADLESS=false
LOCUST_HTTP_USER_WEIGHT=9
LOCUST_BROWSER_USER_WEIGHT=1

# ---- AI assistant (namespace ai-assistant): Envoy routes /chatbot/ there ----
CHATBOT_HOST=chatbot.ai-assistant
CHATBOT_PORT=7860

# ---- Not deployed; Envoy still needs the name to start ----
FIREPIT_HOST=firepit
FIREPIT_PORT=8080
